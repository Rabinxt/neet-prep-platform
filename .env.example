# PostgreSQL connection used by the application and Prisma CLI.
# Use sslmode=require for hosted databases that require TLS.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Better Auth. Generate a unique secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
# Use your deployed origin in production (for example, https://your-domain.com).
BETTER_AUTH_URL="http://localhost:3000"
