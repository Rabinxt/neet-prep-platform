# PostgreSQL application connection used by Next.js and Prisma.
# For Neon/Vercel, use the provider's pooled application URL where supported.
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=require"

# Better Auth. Generate a unique high-entropy value of at least 32 characters.
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
# Origin only: no path, query, fragment, credentials, or trailing application route.
# Development uses localhost; Production must use the canonical HTTPS origin.
BETTER_AUTH_URL="http://localhost:3000"

# Provider-neutral JSON email webhook. The endpoint receives
# { from, to, subject, text, html } with a Bearer authorization header.
EMAIL_FROM="NEET Prep <onboarding@resend.dev>"
RESEND_API_KEY="replace-with-your-resend-api-key"
