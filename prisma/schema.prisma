generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model Subject {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String
  order       Int        @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  chapters    Chapter[]
  questions   Question[]

  @@index([name])
}

model Chapter {
  id          String     @id @default(cuid())
  subjectId   String
  name        String
  slug        String
  description String
  order       Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  subject     Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  topics      Topic[]
  questions   Question[]

  @@unique([subjectId, slug])
  @@unique([subjectId, order])
  @@index([subjectId, name])
}

model Topic {
  id          String     @id @default(cuid())
  chapterId   String
  name        String
  slug        String
  description String
  order       Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  chapter     Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  questions   Question[]

  @@unique([chapterId, slug])
  @@unique([chapterId, order])
  @@index([chapterId, name])
}

model Question {
  id               String            @id @default(cuid())
  importId         String?           @unique
  subjectId        String
  chapterId        String
  topicId          String?
  questionText     String
  explanation      String?
  difficulty       Difficulty        @default(MEDIUM)
  sourceType       QuestionSource    @default(ORIGINAL)
  examYear         Int?
  positiveMarks    Int               @default(4)
  negativeMarks    Int               @default(1)
  order            Int               @default(0)
  isPublished      Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  subject          Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  chapter          Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  topic            Topic?            @relation(fields: [topicId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  options          QuestionOption[]
  attemptQuestions AttemptQuestion[]

  @@index([subjectId, isPublished, difficulty])
  @@index([chapterId, isPublished, difficulty])
  @@index([topicId, isPublished, difficulty])
  @@index([sourceType, examYear, isPublished])
  @@index([chapterId, order])
}

model AnonymousSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  attempts   Attempt[]

  @@index([lastSeenAt])
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  attempts      Attempt[]

  @@index([role])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Attempt {
  id                   String            @id @default(cuid())
  userId               String?
  anonymousSessionId   String?
  type                 AttemptType
  status               AttemptStatus     @default(IN_PROGRESS)
  name                 String
  configuration        Json?
  startedAt            DateTime          @default(now())
  completedAt          DateTime?
  expiresAt            DateTime?
  currentQuestionIndex Int               @default(0)
  totalQuestions       Int
  attemptedQuestions   Int               @default(0)
  correct              Int               @default(0)
  incorrect            Int               @default(0)
  unanswered           Int
  score                Int               @default(0)
  maximumMarks         Int
  accuracy             Float             @default(0)
  subjectBreakdown     Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  user                 User?             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  anonymousSession     AnonymousSession? @relation(fields: [anonymousSessionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  questions            AttemptQuestion[]

  @@index([anonymousSessionId, type, status, updatedAt])
  @@index([userId, type, status, updatedAt])
  @@index([status, expiresAt])
}

model AttemptQuestion {
  id               String                  @id @default(cuid())
  attemptId        String
  sourceQuestionId String?
  order            Int
  questionText     String
  explanation      String?
  difficulty       Difficulty
  sourceType       QuestionSource
  examYear         Int?
  positiveMarks    Int
  negativeMarks    Int
  subjectName      String
  subjectSlug      String
  subjectOrder     Int
  chapterName      String
  chapterSlug      String
  topicName        String?
  topicSlug        String?
  selectedOptionId String?
  responseStatus   AttemptQuestionStatus   @default(NOT_VISITED)
  checkedAt        DateTime?
  isCorrect        Boolean?
  marksAwarded     Int?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  attempt          Attempt                 @relation(fields: [attemptId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sourceQuestion   Question?               @relation(fields: [sourceQuestionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  options          AttemptQuestionOption[] @relation("SnapshotOptions")
  selectedOption   AttemptQuestionOption?  @relation("SelectedAttemptOption", fields: [selectedOptionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([attemptId, order])
  @@unique([attemptId, sourceQuestionId])
  @@index([attemptId, responseStatus])
  @@index([sourceQuestionId])
  @@index([selectedOptionId])
}

model AttemptQuestionOption {
  id                String            @id @default(cuid())
  attemptQuestionId String
  sourceOptionId    String?
  optionText        String
  optionLabel       String
  order             Int
  isCorrect         Boolean
  attemptQuestion   AttemptQuestion   @relation("SnapshotOptions", fields: [attemptQuestionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  selectedBy        AttemptQuestion[] @relation("SelectedAttemptOption")

  @@unique([attemptQuestionId, order])
  @@unique([attemptQuestionId, optionLabel])
  @@index([sourceOptionId])
}

model QuestionOption {
  id          String   @id @default(cuid())
  questionId  String
  optionText  String
  optionLabel String
  order       Int
  isCorrect   Boolean  @default(false)
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([questionId, optionLabel])
  @@unique([questionId, order])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionSource {
  ORIGINAL
  PYQ
  SAMPLE
}

enum AttemptType {
  PRACTICE
  MOCK_EXAM
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
  ABANDONED
}

enum AttemptQuestionStatus {
  NOT_VISITED
  NOT_ANSWERED
  ANSWERED
  MARKED_FOR_REVIEW
  ANSWERED_AND_MARKED_FOR_REVIEW
}

enum UserRole {
  STUDENT
  ADMIN
}
